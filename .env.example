THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
APIFY_TOKEN=
APIFY_THREADS_ACTOR_ID=futurizerush/meta-threads-scraper
APIFY_LIVE_CRAWL_ENABLED=false
APIFY_MAX_LIVE_RUNS_PER_SESSION=1
APIFY_CACHE_TTL_HOURS=24
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_SOURCE_MODE=experimental
APP_ENV=local

